# Copy to .env for local dev (never commit .env). On Render, set these in the
# service's Environment tab instead — see "Deployment" in CLAUDE.md.

# Aiven Service URI from the Aiven console. Keep ?sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Any long random string (required whenever DJANGO_DEBUG is not true).
DJANGO_SECRET_KEY=change-me

# true only for local dev; anything else (or unset) means production mode.
DJANGO_DEBUG=true

# Comma-separated hostnames, no scheme. Production: the service's onrender.com host.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Seconds to keep DB connections open. 0 (default) = close per request; safest on Aiven small plans.
DB_CONN_MAX_AGE=0

# Only for `manage.py seed_data`: an already-hashed (pbkdf2_sha256$...) password. Not needed on Render.
SEED_PASSWORD_HASH=
